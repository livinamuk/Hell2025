#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../common/normal_encoding.glsl"
#include "../common/reconstruction.glsl"
#include "../common/Vulkan/VK_binding_indices.glsl"
#include "../common/Vulkan/VK_push_constants.glsl"
#include "../common/viewport.glsl"
#include "VK_indirect_specular_amd_config.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = DESC_IDX_SAMPLERS) uniform sampler samplers[];
layout(set = 0, binding = DESC_IDX_TEXTURES) uniform texture2D textures[];
layout(set = 0, binding = DESC_IDX_STORAGE_IMAGES_RGBA16F, rgba16f) uniform image2D storageImagesRGBA16F[];
layout(set = 0, binding = DESC_IDX_STORAGE_IMAGES_R16F, r16f) uniform image2D storageImagesR16F[];
layout(set = 0, binding = DESC_IDX_SSBOS, std430) buffer AMDStorageBuffer { uint data[]; } amdStorageBuffers[];

layout(push_constant, scalar) uniform PushConstants {
    PushConstantsIndirectSpecularAMDPrefilter data;
} pc;

const float DNSR_RADIANCE_WEIGHT_BIAS = 0.6;
const float DNSR_RADIANCE_WEIGHT_VARIANCE_K = 0.1;
const float DNSR_PREFILTER_VARIANCE_WEIGHT = 4.4;
const float DNSR_PREFILTER_VARIANCE_BIAS = 0.1;
const float DNSR_PREFILTER_NORMAL_SIGMA = 512.0;
const float DNSR_PREFILTER_DEPTH_SIGMA = 4.0;
const float DNSR_GLOSSY_ROUGHNESS_THRESHOLD = VK_INDIRECT_SPECULAR_AMD_ROUGHNESS_THRESHOLD;
const float DNSR_MIRROR_ROUGHNESS_THRESHOLD = 0.0001;

shared uint g_dnsrShared0[16][16];
shared uint g_dnsrShared1[16][16];
shared uint g_dnsrShared2[16][16];
shared uint g_dnsrShared3[16][16];
shared float g_dnsrSharedDepth[16][16];
shared uint g_dnsrSharedViewportIndex[16][16];

struct NeighborhoodSample {
    vec3 radiance;
    float variance;
    vec3 normal;
    float depth;
    uint viewportIndex;
};

bool IsPixelInBounds(ivec2 pixelCoord, ivec2 size) {
    return all(greaterThanEqual(pixelCoord, ivec2(0))) && all(lessThan(pixelCoord, size));
}

uvec2 RemapLane8x8(uint lane) {
    uint x = (((lane >> 2u) & 7u) & ~1u) | (lane & 1u);
    uint y = (((lane >> 3u) & 7u) & ~3u) | ((lane >> 1u) & 3u);
    return uvec2(x, y);
}

uvec2 RoundUp8(uvec2 value) {
    uvec2 roundDown = value & ~uvec2(7u);
    return uvec2(
        roundDown.x == value.x ? value.x : value.x + 8u,
        roundDown.y == value.y ? value.y : value.y + 8u);
}

ivec2 FullResolutionPixelFromLowResolutionPixel(ivec2 lowPixel, ivec2 lowSize, ivec2 fullSize) {
    vec2 uv = ScreenUVFromPixel(lowPixel, lowSize);
    return clamp(ivec2(uv * vec2(fullSize)), ivec2(0), fullSize - ivec2(1));
}

float LoadRoughness(ivec2 pixelCoord, ivec2 screenSize) {
    if (!IsPixelInBounds(pixelCoord, screenSize)) return 1.0;
    return texelFetch(sampler2D(textures[VULKAN_TEXTURE_IDX_INDIRECT_SPECULAR_AMD_EXTRACTED_ROUGHNESS], samplers[VULKAN_SAMPLER_IDX_NEAREST]), pixelCoord, 0).r;
}

NeighborhoodSample LoadNeighborhood(ivec2 pixelCoord, ivec2 screenSize, RendererData rendererData) {
    NeighborhoodSample sampleValue;
    sampleValue.radiance = vec3(0.0);
    sampleValue.variance = 0.0;
    sampleValue.normal = vec3(0.0);
    sampleValue.depth = 0.0;
    sampleValue.viewportIndex = 0xffffffffu;
    if (!IsPixelInBounds(pixelCoord, screenSize)) return sampleValue;

    ivec2 fullSize = textureSize(sampler2D(textures[VULKAN_TEXTURE_IDX_GBUFFER_DEPTH], samplers[VULKAN_SAMPLER_IDX_NEAREST]), 0);
    ivec2 fullPixel = FullResolutionPixelFromLowResolutionPixel(pixelCoord, screenSize, fullSize);
    ViewportDataBuffer viewportDataBuffer = pc.data.frame.viewportDataBuffer;
    sampleValue.viewportIndex = ViewportIndexFromPixel(fullPixel, fullSize, rendererData.viewportLayout, vec2(rendererData.viewportSplitX, rendererData.viewportSplitY));
    ivec4 viewportRect = ivec4(viewportDataBuffer.viewportData[sampleValue.viewportIndex].xOffset, viewportDataBuffer.viewportData[sampleValue.viewportIndex].yOffset, viewportDataBuffer.viewportData[sampleValue.viewportIndex].width, viewportDataBuffer.viewportData[sampleValue.viewportIndex].height);
    mat4 inverseProjection = viewportDataBuffer.viewportData[sampleValue.viewportIndex].inverseProjectionReverseZ;

    sampleValue.radiance = texelFetch(sampler2D(textures[VULKAN_TEXTURE_IDX_INDIRECT_SPECULAR_AMD_INPUT], samplers[VULKAN_SAMPLER_IDX_NEAREST]), pixelCoord, 0).rgb;
    sampleValue.variance = texelFetch(sampler2D(textures[VULKAN_TEXTURE_IDX_INDIRECT_SPECULAR_AMD_VARIANCE], samplers[VULKAN_SAMPLER_IDX_NEAREST]), pixelCoord,0).r;

    vec2 encodedNormal = texelFetch(sampler2D(textures[VULKAN_TEXTURE_IDX_NORMAL_XY_ROUGHNESS_MISC], samplers[VULKAN_SAMPLER_IDX_NEAREST]), fullPixel, 0).rg;
    sampleValue.normal = DecodeOct(encodedNormal);

    float reverseDepth = texelFetch(sampler2D(textures[VULKAN_TEXTURE_IDX_GBUFFER_DEPTH], samplers[VULKAN_SAMPLER_IDX_NEAREST]), fullPixel, 0).r;
    
    if (reverseDepth > 0.0) {
        sampleValue.depth = LinearViewDepthFromNDC(ViewportNDCFromPixel(fullPixel, fullSize, viewportRect), reverseDepth, inverseProjection);
    }

    return sampleValue;
}

void StoreShared(ivec2 coord, NeighborhoodSample sampleValue) {
    g_dnsrShared0[coord.y][coord.x] = packHalf2x16(sampleValue.radiance.xy);
    g_dnsrShared1[coord.y][coord.x] = packHalf2x16(vec2(sampleValue.radiance.z));
    g_dnsrShared2[coord.y][coord.x] = packHalf2x16(sampleValue.normal.xy);
    g_dnsrShared3[coord.y][coord.x] = packHalf2x16(vec2(sampleValue.normal.z, sampleValue.variance));
    g_dnsrSharedDepth[coord.y][coord.x] = sampleValue.depth;
    g_dnsrSharedViewportIndex[coord.y][coord.x] = sampleValue.viewportIndex;
}

NeighborhoodSample LoadShared(ivec2 coord) {
    vec4 unpackedRadiance = vec4(
        unpackHalf2x16(g_dnsrShared0[coord.y][coord.x]),
        unpackHalf2x16(g_dnsrShared1[coord.y][coord.x]));

    vec4 unpackedNormalVariance = vec4(
        unpackHalf2x16(g_dnsrShared2[coord.y][coord.x]),
        unpackHalf2x16(g_dnsrShared3[coord.y][coord.x]));

    NeighborhoodSample sampleValue;
    sampleValue.radiance = unpackedRadiance.rgb;
    sampleValue.variance = unpackedNormalVariance.w;
    sampleValue.normal = unpackedNormalVariance.xyz;
    sampleValue.depth = g_dnsrSharedDepth[coord.y][coord.x];
    sampleValue.viewportIndex = g_dnsrSharedViewportIndex[coord.y][coord.x];
    return sampleValue;
}

void InitializeSharedNeighborhood(ivec2 dispatchThreadID, ivec2 groupThreadID, ivec2 screenSize, RendererData rendererData) {

    const ivec2 offsets[4] = ivec2[4](
        ivec2(0, 0),
        ivec2(8, 0),
        ivec2(0, 8),
        ivec2(8, 8));

    ivec2 sampleBase = dispatchThreadID - ivec2(4);
    NeighborhoodSample samples[4];
    
    for (int i = 0; i < 4; ++i) {
        samples[i] = LoadNeighborhood(sampleBase + offsets[i], screenSize, rendererData);
    }
    
    for (int i = 0; i < 4; ++i) {
        StoreShared(groupThreadID + offsets[i], samples[i]);
    }
}

float GetEdgeStoppingNormalWeight(vec3 normalP, vec3 normalQ) {
    return pow(max(dot(normalP, normalQ), 0.0), DNSR_PREFILTER_NORMAL_SIGMA);
}

float GetEdgeStoppingDepthWeight(float centerDepth, float neighborDepth) {
    return exp(-abs(centerDepth - neighborDepth) * centerDepth * DNSR_PREFILTER_DEPTH_SIGMA);
}

float GetRadianceWeight(vec3 centerRadiance, vec3 neighborRadiance, float variance) {
    return max(exp(-(DNSR_RADIANCE_WEIGHT_BIAS + variance * DNSR_RADIANCE_WEIGHT_VARIANCE_K)
        * length(centerRadiance - neighborRadiance)), 1.0e-2);
}

void ResolvePrefilter(ivec2 sharedCenter, vec3 averageRadiance, NeighborhoodSample center, out vec3 resolvedRadiance, out float resolvedVariance) {
    float accumulatedWeight = GetRadianceWeight(averageRadiance, center.radiance, center.variance);
    vec3 accumulatedRadiance = center.radiance * accumulatedWeight;
    float accumulatedVariance = center.variance * accumulatedWeight * accumulatedWeight;

    const ivec2 sampleOffsets[15] = ivec2[15](
        ivec2(0, 1),
        ivec2(-2, 1),
        ivec2(2, -3),
        ivec2(-3, 0),
        ivec2(1, 2),
        ivec2(-1, -2),
        ivec2(3, 0),
        ivec2(-3, 3),
        ivec2(0, -3),
        ivec2(-1, -1),
        ivec2(2, 1),
        ivec2(-2, -2),
        ivec2(1, 0),
        ivec2(0, 2),
        ivec2(3, -1));

    float varianceWeight = max(DNSR_PREFILTER_VARIANCE_BIAS, 1.0 - exp(-(center.variance * DNSR_PREFILTER_VARIANCE_WEIGHT)));

    for (int i = 0; i < 15; ++i) {
        NeighborhoodSample neighbor = LoadShared(sharedCenter + sampleOffsets[i]);
        float weight = neighbor.viewportIndex == center.viewportIndex ? 1.0 : 0.0;
        weight *= GetEdgeStoppingNormalWeight(center.normal, neighbor.normal);
        weight *= GetEdgeStoppingDepthWeight(center.depth, neighbor.depth);
        weight *= GetRadianceWeight(averageRadiance, neighbor.radiance, center.variance);
        weight *= varianceWeight;

        accumulatedWeight += weight;
        accumulatedRadiance += weight * neighbor.radiance;
        accumulatedVariance += weight * weight * neighbor.variance;
    }

    accumulatedRadiance /= accumulatedWeight;
    accumulatedVariance /= accumulatedWeight * accumulatedWeight;
    resolvedRadiance = accumulatedRadiance;
    resolvedVariance = accumulatedVariance;
}

void main() {
    uint packedCoords = amdStorageBuffers[VULKAN_SSBO_IDX_INDIRECT_SPECULAR_AMD_DENOISER_TILE_LIST].data[gl_WorkGroupID.x];
    ivec2 tileBase = ivec2(int(packedCoords & 0xffffu), int((packedCoords >> 16u) & 0xffffu));
    ivec2 dispatchThreadID = tileBase + ivec2(gl_LocalInvocationID.xy);
    ivec2 dispatchGroupID = dispatchThreadID / 8;
    uvec2 remappedGroupThreadID = RemapLane8x8(gl_LocalInvocationIndex);
    dispatchThreadID = dispatchGroupID * 8 + ivec2(remappedGroupThreadID);
    ivec2 groupThreadID = ivec2(remappedGroupThreadID);

    ivec2 screenSize = textureSize(sampler2D(textures[VULKAN_TEXTURE_IDX_INDIRECT_SPECULAR_AMD_INPUT], samplers[VULKAN_SAMPLER_IDX_NEAREST]), 0);
    bool inBounds = IsPixelInBounds(dispatchThreadID, screenSize);

    RendererData rendererData = pc.data.frame.rendererDataBuffer.rendererData;
    float centerRoughness = LoadRoughness(dispatchThreadID, screenSize);
    InitializeSharedNeighborhood(dispatchThreadID, groupThreadID, screenSize, rendererData);

    memoryBarrierShared();
    barrier();

    ivec2 sharedCenter = groupThreadID + ivec2(4);
    NeighborhoodSample center = LoadShared(sharedCenter);
    vec3 resolvedRadiance = center.radiance;
    float resolvedVariance = center.variance;

    bool needsDenoiser = center.variance > 0.0
        && centerRoughness < DNSR_GLOSSY_ROUGHNESS_THRESHOLD
        && centerRoughness >= DNSR_MIRROR_ROUGHNESS_THRESHOLD;

    if (needsDenoiser) {
        uvec2 roundedScreenSize = RoundUp8(uvec2(screenSize));
        vec2 averageUV = (vec2(dispatchThreadID) + 0.5) / vec2(roundedScreenSize);
        vec3 averageRadiance = textureLod(sampler2D(textures[VULKAN_TEXTURE_IDX_INDIRECT_SPECULAR_AMD_AVERAGE_HISTORY], samplers[VULKAN_SAMPLER_IDX_LINEAR]), averageUV, 0.0).rgb;
        
        ResolvePrefilter(sharedCenter, averageRadiance, center, resolvedRadiance, resolvedVariance);
    }

    if (!inBounds) return;

    imageStore(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_INDIRECT_SPECULAR_AMD_PREFILTERED], dispatchThreadID, vec4(resolvedRadiance, resolvedRadiance.z));
    imageStore(storageImagesR16F[VULKAN_STORAGE_IMAGE_R16F_IDX_INDIRECT_SPECULAR_AMD_PREFILTERED_VARIANCE], dispatchThreadID, vec4(resolvedVariance, 0.0, 0.0, 0.0));
}
