#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../common/Vulkan/VK_binding_indices.glsl"
#include "../common/Vulkan/VK_push_constants.glsl"

#include "../common/post_processing.glsl"
#include "../common/types.glsl"
#include "../common/util.glsl"
#include "../common/viewport.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = DESC_IDX_STORAGE_IMAGES_RGBA16F, rgba16f) uniform image2D storageImagesRGBA16F[];

layout(push_constant, scalar) uniform PushConstants {
    PushConstantsPostProcessing data;
} pc;






vec3 ACES(vec3 x) {
    const float a=2.51, b=0.03, c=2.43, d=0.59, e=0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 sat(vec3 c, float s) {
    float Y = luma(c);
    return mix(vec3(Y), c, s);
}

vec3 softContrast(vec3 c, float k) {
    float m = 0.5;
    return mix(m + (c - m) * (1.0 + (k - 1.0)), c, 0.0);
}

vec3 ApplyVignette(vec3 inputColor, vec3 vignetteColor, float intensityScalar, vec2 uv) {
    float vignetteSize = 0.75;
    float vignetteShape = 1.0;
    float vignetteSmoothness = 0.845;

    vec2 centeredUv = uv - 0.5;
    centeredUv.x *= vignetteShape;
    float dist = length(centeredUv);
    float mask = smoothstep(vignetteSize, vignetteSize - vignetteSmoothness, dist);
    float blend = (1.0 - mask) * intensityScalar;
    return mix(inputColor, vignetteColor, blend);
}

// pass in pre-computed data to avoid redundant imageLoad and math
vec3 RE(vec3 lighting, vec2 uv_screenspace, ivec2 pixelCoords, uint viewportIndex, vec3 colorTint, float contrast, ivec2 outputImageSize) {
    vec3 finalColor = lighting;


    finalColor = Tonemap_ACES(lighting);
    finalColor = pow(finalColor, vec3(1.0 / 2.2));
    finalColor = clamp(finalColor, 0.0, 1.0);

    float Y = luma(finalColor);
    float sh = smoothstep(0.60, 0.20, Y);
    float mi = smoothstep(0.15, 0.65, Y) * (1.0 - smoothstep(0.70, 0.95, Y));
    float hi = smoothstep(0.55, 0.95, Y);

    float blackProtectEdge = 0.2;
    float protect = smoothstep(0.0, blackProtectEdge, Y);

    vec3 shadowTint = vec3(0.20, 0.30, 0.55);
    vec3 highlightTint = vec3(1.03, 0.98, 0.95);
    float bleach = 0.2;
    float blueAir = 0.48;

    vec3 delta = vec3(0.0);
    delta += (shadowTint * 0.22) * sh * protect;
    finalColor *= mix(vec3(1.0), highlightTint, hi * 0.12 * protect);

    float grayBP = dot(finalColor, vec3(0.299, 0.587, 0.114));
    vec3 maxc = max(finalColor, vec3(grayBP));
    finalColor = mix(finalColor, maxc, bleach * protect);

    delta += vec3(0.10, 0.16, 0.35) * blueAir * mi;
    finalColor += delta * protect;

    float k = 0.92;
    float m = 0.18;

    finalColor = mix(finalColor, m + (finalColor - m) * (1.0 + (k - 1.0)), protect);
    finalColor *= colorTint;
    finalColor.rgb = AdjustContrast(finalColor.rgb, contrast);

    // noise processing
    float time = 0;//rendererData.time;
    vec2 coord = vec2(pixelCoords);
    vec2 rest = modf(uv_screenspace * outputImageSize, coord);
    vec3 noise00 = FilmPixel(coord / outputImageSize, time);
    vec3 noise01 = FilmPixel((coord + vec2(0, 1)) / outputImageSize, time);
    vec3 noise10 = FilmPixel((coord + vec2(1, 0)) / outputImageSize, time);
    vec3 noise11 = FilmPixel((coord + vec2(1, 1)) / outputImageSize, time);

    float noiseSpeed = 15.0;
    float x = Rand(uv_screenspace + Rand(vec2(int(time * noiseSpeed), int(-time * noiseSpeed))));
    float noiseFactor = 0.035;
    finalColor = finalColor + (x * -noiseFactor) + (noiseFactor / 2.0);

    float gray = dot(finalColor.rgb, vec3(0.299, 0.587, 0.114));
    finalColor.rgb = mix(finalColor.rgb, vec3(gray), 0.0); // based on 1.0 saturation amount

    return finalColor;
}

vec3 OG(vec3 lighting, vec2 uv_screenspace, ivec2 pixelCoords, uint viewportIndex, vec3 colorTint, float contrast) {
    vec3 finalColor = lighting;
    vec3 colorTintCursed = colorTint.rgb * vec3(1, 0.925, 0.925);

    finalColor = Tonemap_ACES(lighting);
    finalColor = pow(finalColor, vec3(1.0 / 2.2));
    finalColor = clamp(finalColor, 0, 1);
    finalColor = mix(finalColor, Tonemap_ACES(finalColor), 0.125);

    finalColor *= colorTintCursed;
    finalColor.rgb = AdjustContrast(finalColor.rgb, contrast);

    float gray = dot(finalColor.rgb, vec3(0.299, 0.587, 0.114));
    return mix(finalColor.rgb, vec3(gray), 0.0);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 targetSize = imageSize(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING]);

    if (texel.x >= targetSize.x || texel.y >= targetSize.y) return;

    ViewportDataBuffer viewportDataBuffer = pc.data.frame.viewportDataBuffer;
    RendererDataBuffer rendererDataBuffer = pc.data.frame.rendererDataBuffer;


    vec4 color = imageLoad(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING], texel);
    //color.rgb *= vec3(100.0, 0.0, 0.0);

    ivec2 outputSize = targetSize;


   ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    vec2 uv = (vec2(pixelCoords) + 0.5) / outputSize;
    vec3 rawLighting = color.rgb;
    uint viewportIndex = ViewportIndexFromPixel(pixelCoords, outputSize, rendererDataBuffer.rendererData.viewportLayout, vec2(rendererDataBuffer.rendererData.viewportSplitX, rendererDataBuffer.rendererData.viewportSplitY));

    if (!IsViewportActive(viewportIndex, rendererDataBuffer.rendererData.activeViewportMask)) {
        imageStore(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING], texel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    ivec4 viewportRect = ivec4(viewportDataBuffer.viewportData[viewportIndex].xOffset, viewportDataBuffer.viewportData[viewportIndex].yOffset, viewportDataBuffer.viewportData[viewportIndex].width, viewportDataBuffer.viewportData[viewportIndex].height);
    float contrast = viewportDataBuffer.viewportData[viewportIndex].colorContrast;
    vec3 colorTint = viewportDataBuffer.viewportData[viewportIndex].colorTint.rgb;

    // compute the two looks
    vec3 ogLook = OG(rawLighting, uv, pixelCoords, viewportIndex, colorTint, contrast);
    vec3 reLook = RE(rawLighting, uv, pixelCoords, viewportIndex, colorTint, contrast, outputSize);

    // blend and apply brightness hack
    vec3 finalColor = mix(ogLook, reLook, 0.25);
    finalColor += vec3(0.0125);


     //finalColor = ogLook;

     // vignette setup
     vec2 viewportUV = ViewportUVFromPixel(pixelCoords, outputSize, viewportRect);
     finalColor = ApplyVignette(finalColor, viewportDataBuffer.viewportData[viewportIndex].vignetteColor.rgb, viewportDataBuffer.viewportData[viewportIndex].intensityScalar * 0.5, viewportUV);















    imageStore(storageImagesRGBA16F[VULKAN_STORAGE_IMAGE_IDX_GBUFFER_LIGHTING], texel, vec4(finalColor, 1.0));
}
