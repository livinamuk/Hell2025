#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../common/types.glsl"
#include "../common/Vulkan/VK_push_constants.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PushConstants {
    PushConstantsDDGIProbeIrradianceDirtyPointCheck data;
} pc;

layout(buffer_reference, scalar) buffer ProbeStatesBuffer { ProbeState probeStates[]; };
layout(buffer_reference, scalar) readonly buffer ProbePointIndicesBuffer { uint probePointIndices[]; };
layout(buffer_reference, scalar) readonly buffer ProbePointOffsetsBuffer { uint probePointOffsets[]; };
layout(buffer_reference, scalar) readonly buffer ProbePointCountsBuffer { uint probePointCounts[]; };
layout(buffer_reference, scalar) readonly buffer PointCloudDirtyFlagsBuffer { uint pointCloudDirtyFlags[]; };

void main() {
    uint probeIdx = gl_GlobalInvocationID.x;
    if (probeIdx >= pc.data.totalProbes) return;

    ProbeStatesBuffer probeStates = ProbeStatesBuffer(pc.data.probeStatesDeviceAddress);
    ProbePointIndicesBuffer probePointIndices = ProbePointIndicesBuffer(pc.data.probePointIndicesDeviceAddress);
    ProbePointOffsetsBuffer probePointOffsets = ProbePointOffsetsBuffer(pc.data.probePointOffsetsDeviceAddress);
    ProbePointCountsBuffer probePointCounts = ProbePointCountsBuffer(pc.data.probePointCountsDeviceAddress);
    PointCloudDirtyFlagsBuffer pointCloudDirtyFlags = PointCloudDirtyFlagsBuffer(pc.data.pointCloudDirtyFlagsDeviceAddress);

    uint globalProbeIdx = pc.data.probeOffset + probeIdx;
    uint currentCooldown = probeStates.probeStates[globalProbeIdx].irradianceCooldown;

    if (currentCooldown == PROBE_MAX_IRRADIANCE_COOLDOWN) {
        return;
    }

    uint offset = probePointOffsets.probePointOffsets[probeIdx];
    uint count = probePointCounts.probePointCounts[probeIdx];

    uint i = 0u;
    for (; i + 3u < count; i += 4u) {
        uint p0 = probePointIndices.probePointIndices[offset + i];
        uint p1 = probePointIndices.probePointIndices[offset + i + 1u];
        uint p2 = probePointIndices.probePointIndices[offset + i + 2u];
        uint p3 = probePointIndices.probePointIndices[offset + i + 3u];
        uint sum = pointCloudDirtyFlags.pointCloudDirtyFlags[p0] + pointCloudDirtyFlags.pointCloudDirtyFlags[p1] + pointCloudDirtyFlags.pointCloudDirtyFlags[p2] + pointCloudDirtyFlags.pointCloudDirtyFlags[p3];

        if (sum > 0u) {
            currentCooldown = PROBE_MAX_IRRADIANCE_COOLDOWN;
            break;
        }
    }

    if (currentCooldown != PROBE_MAX_IRRADIANCE_COOLDOWN) {
        for (; i < count; i++) {
            uint pointIdx = probePointIndices.probePointIndices[offset + i];
            if (pointCloudDirtyFlags.pointCloudDirtyFlags[pointIdx] == 1u) {
                currentCooldown = PROBE_MAX_IRRADIANCE_COOLDOWN;
                break;
            }
        }
    }

    probeStates.probeStates[globalProbeIdx].irradianceCooldown = currentCooldown;
}
