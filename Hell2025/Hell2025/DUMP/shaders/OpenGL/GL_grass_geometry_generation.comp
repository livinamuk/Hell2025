#version 460 core
#include "../common/OpenGL/GL_binding_indices.glsl"
#include "../common/constants.glsl"
#include "../common/types.glsl"
#include "../common/util.glsl"

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct Vertex {
    float posX;
    float posY;
    float posZ;
    float normX;

    float normY;
    float normZ;
};

layout(std430, binding = SSBO_IDX_GRASS_GEOMETRY_OUTPUT_VERTICES) buffer outputVertexBuffer {
    Vertex OutputVertexBuffer[];
};

layout(std430, binding = SSBO_IDX_GRASS_GEOMETRY_OUTPUT_INDICES) buffer outputIndexBuffer {
    uint OutputIndexBuffer[];
};

uniform int u_segmentCount;
uniform float u_curveAmount;
uniform float u_bladeHeight;
uniform float u_bladeWidth;

float HashFloat(uint seed) {
    seed = (seed ^ 61u) ^ (seed >> 16);
    seed *= 9u;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15);
    return float(seed & 0x7FFFFFFF) / float(0x7FFFFFFF); // Normalize to [0,1]
}


vec3 GetPosition(uint vertexIndex) {
    const Vertex vertex = OutputVertexBuffer[vertexIndex];
    return vec3(vertex.posX, vertex.posY, vertex.posZ);
}

void SetPosition(uint vertexIndex, vec3 position) {
    OutputVertexBuffer[vertexIndex].posX = position.x;
    OutputVertexBuffer[vertexIndex].posY = position.y;
    OutputVertexBuffer[vertexIndex].posZ = position.z;
}

void SetNormal(uint vertexIndex, vec3 normal) {
    OutputVertexBuffer[vertexIndex].normX = normal.x;
    OutputVertexBuffer[vertexIndex].normY = normal.y;
    OutputVertexBuffer[vertexIndex].normZ = normal.z;
}

void main() {
    const int segmentCount = max(u_segmentCount, 1);
    const uint frontVertexCount = uint((segmentCount + 1) * 2);
    const uint verticesPerBlade = frontVertexCount * 2u;
    const uint frontIndexCount = uint(segmentCount * 6);
    const uint indicesPerBlade = frontIndexCount * 2u;
    const uint invocationID = gl_GlobalInvocationID.x;
    const uint baseVertex = invocationID * verticesPerBlade;
    const uint baseIndex = invocationID * indicesPerBlade;

    float bladeHeight = u_bladeHeight;
    const float bottomWidth = u_bladeWidth;
    const float topWidth = u_bladeWidth * (2.0 / 3.0);

    const uint seed1 = invocationID * 2654435761u + 1013904223u;
    const uint seed2 = invocationID * 1664525u + 374761393u;
    const float rand1 = HashFloat(seed1);
    const float rand2 = HashFloat(seed2);
    bladeHeight *= mix(1.0, 4.0 / 3.0, Rand(vec2(rand2, rand1)));

    const float bendAmount = pow(Rand(vec2(rand1 * 1.5, rand2 * 1.7)), 1.5);
    const vec3 bendDirection1 = vec3(
        (Rand(vec2(rand1, rand2)) * 2.0 - 1.0) * bendAmount,
        0.0,
        (Rand(vec2(rand1 * 1.5, rand2 * 0.8)) * 2.0 - 1.0) * bendAmount);
    const vec3 bendDirection2 = vec3(
        Rand(vec2(rand2, rand1)) * 2.0 - 1.0,
        0.0,
        Rand(vec2(rand2, rand1)) * 2.0 - 1.0);
    const vec3 bendDirection = mix(bendDirection1, bendDirection2, 0.5) * u_curveAmount;

    const float rotationAngle = Rand(vec2(rand1, rand2)) * 3.14159265 * 2.0;
    const mat2 rotationMatrix = mat2(
        cos(rotationAngle), -sin(rotationAngle),
        sin(rotationAngle), cos(rotationAngle));

    vec3 basePosition = vec3(0.0);
    const float jitterX = (Rand(vec2(rand1, rand2)) - 0.5) * 0.0125;
    const float jitterZ = (Rand(vec2(rand2, rand1)) - 0.5) * 0.0125;
    basePosition += vec3(jitterX, jitterZ * 2.0, jitterZ);

    // Every segment count samples the same analytic centerline. The factor
    // of three preserves the old maximum tip displacement at the default
    // curve amount while keeping the root fixed.
    for (int row = 0; row <= segmentCount; row++) {
        const float t = float(row) / float(segmentCount);
        const float width = mix(bottomWidth, topWidth, t);
        const vec3 curveOffset = bendDirection * (3.0 * t * t);
        const vec3 rowCenter = basePosition + vec3(0.0, bladeHeight * t, 0.0) + curveOffset;

        vec3 leftPosition = rowCenter + vec3(-width, 0.0, 0.0);
        vec3 rightPosition = rowCenter + vec3(width, 0.0, 0.0);
        leftPosition.xz = rotationMatrix * (leftPosition.xz - basePosition.xz) + basePosition.xz;
        rightPosition.xz = rotationMatrix * (rightPosition.xz - basePosition.xz) + basePosition.xz;

        const uint rowVertex = baseVertex + uint(row * 2);
        SetPosition(rowVertex, leftPosition);
        SetPosition(rowVertex + 1u, rightPosition);
    }

    // Smooth row normals follow the same curve sampled by the vertex shader
    // tangent calculation.
    for (int row = 0; row <= segmentCount; row++) {
        const int previousRow = max(row - 1, 0);
        const int nextRow = min(row + 1, segmentCount);
        const uint rowVertex = baseVertex + uint(row * 2);
        const uint previousVertex = baseVertex + uint(previousRow * 2);
        const uint nextVertex = baseVertex + uint(nextRow * 2);
        const vec3 previousCenter = (GetPosition(previousVertex) + GetPosition(previousVertex + 1u)) * 0.5;
        const vec3 nextCenter = (GetPosition(nextVertex) + GetPosition(nextVertex + 1u)) * 0.5;
        const vec3 tangent = normalize(nextCenter - previousCenter);
        const vec3 side = normalize(GetPosition(rowVertex + 1u) - GetPosition(rowVertex));
        const vec3 normal = -normalize(cross(tangent, side));
        SetNormal(rowVertex, normal);
        SetNormal(rowVertex + 1u, normal);
    }

    for (int segment = 0; segment < segmentCount; segment++) {
        const uint i0 = baseVertex + uint(segment * 2);
        const uint i1 = i0 + 1u;
        const uint i2 = i0 + 2u;
        const uint i3 = i0 + 3u;
        const uint index = baseIndex + uint(segment * 6);

        OutputIndexBuffer[index + 0u] = i0;
        OutputIndexBuffer[index + 1u] = i1;
        OutputIndexBuffer[index + 2u] = i2;
        OutputIndexBuffer[index + 3u] = i1;
        OutputIndexBuffer[index + 4u] = i3;
        OutputIndexBuffer[index + 5u] = i2;
    }

    const uint backVertexBase = baseVertex + frontVertexCount;
    for (uint vertexOffset = 0u; vertexOffset < frontVertexCount; vertexOffset++) {
        const uint frontVertex = baseVertex + vertexOffset;
        const uint backVertex = backVertexBase + vertexOffset;
        SetPosition(backVertex, GetPosition(frontVertex));
        SetNormal(backVertex, -vec3(
            OutputVertexBuffer[frontVertex].normX,
            OutputVertexBuffer[frontVertex].normY,
            OutputVertexBuffer[frontVertex].normZ));
    }

    for (int segment = 0; segment < segmentCount; segment++) {
        const uint i0 = backVertexBase + uint(segment * 2);
        const uint i1 = i0 + 1u;
        const uint i2 = i0 + 2u;
        const uint i3 = i0 + 3u;
        const uint index = baseIndex + frontIndexCount + uint(segment * 6);

        OutputIndexBuffer[index + 0u] = i2;
        OutputIndexBuffer[index + 1u] = i1;
        OutputIndexBuffer[index + 2u] = i0;
        OutputIndexBuffer[index + 3u] = i2;
        OutputIndexBuffer[index + 4u] = i3;
        OutputIndexBuffer[index + 5u] = i1;
    }
}
