#version 460
#extension GL_ARB_bindless_texture : enable
#include "../common/OpenGL/GL_binding_indices.glsl"
#include "../common/lighting.glsl"
#include "../common/reconstruction.glsl"
#include "../common/types.glsl"
#include "../common/util.glsl"
#include "../common/viewport.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout (binding = 1) uniform sampler2D u_depthTexture;
layout (binding = 2) uniform sampler3D uNoiseVol;
layout (binding = 4, rgba16f) uniform image2D OutputFogImage;

readonly restrict layout(std430, binding = SSBO_IDX_SAMPLERS) buffer textureSamplersBuffer { uvec2 textureSamplers[]; };
readonly restrict layout(std430, binding = SSBO_IDX_RENDERER_DATA) buffer rendererDataBuffer { RendererData rendererData; };
readonly restrict layout(std430, binding = SSBO_IDX_VIEWPORT_DATA) buffer viewportDataBuffer { ViewportData viewportData[]; };
readonly restrict layout(std430, binding = SSBO_IDX_SPOT_LIGHTS) buffer spotLightsBuffer { SpotLight spotLights[]; };

uniform int u_noiseSeed;
uniform float u_time;

uniform int u_fogEnabled;
uniform vec3 u_fogColor;
uniform float u_fogColorStrength;

uniform float u_maxRayDistance;
uniform int u_stepCount;
uniform float u_densityBias;
uniform float u_densityScale;
uniform float u_extinctionScale;
uniform float u_ambientStartDistance;
uniform float u_ambientEndDistance;
uniform float u_ambientExponent;

uniform float u_heightFadeStart;
uniform float u_heightFadeEnd;
uniform float u_heightExponent;
uniform float u_lowHeightScatterMultiplier;

uniform float u_distanceFogStart;
uniform float u_distanceFogEnd;
uniform float u_distanceFogExponent;
uniform float u_distanceFogStrength;

uniform float u_clumpSizeXZ;
uniform float u_clumpSizeY;
uniform float u_noiseScaleNearMultiplier;
uniform float u_noiseScaleFarMultiplier;
uniform float u_noiseScaleStartDistance;
uniform float u_noiseScaleEndDistance;
uniform float u_noiseScaleExponent;

uniform float u_noiseMipBias;
uniform float u_noiseMipScale;
uniform float u_noiseMinMip;
uniform float u_noiseMaxMip;
uniform float u_noiseNearMip;
uniform float u_noiseFarMip;
uniform float u_noiseMipNearDistance;
uniform float u_noiseMipFarDistance;
uniform float u_noiseMipExponent;
uniform float u_noiseMipRespectStep;

uniform vec3 u_windVelocity;
uniform float u_timeScrollSpeed;
uniform float u_xMorphSpeed;
uniform float u_zMorphSpeed;
uniform float u_yScrollSpeed;

const int MAX_FOG_STEPS = 128;

// Random sampling functions
uint seed = 0u;

void hash(){
    seed ^= 2747636419u;
    seed *= 2654435769u;
    seed ^= seed >> 16;
    seed *= 2654435769u;
    seed ^= seed >> 16;
    seed *= 2654435769u;
}

float random(){
    hash();
    return float(seed)/4294967295.0;
}

// Compute a mip level that matches the current step length dt to the world-space texel size of mip 0.
// This helps prevent undersampling when NUM_STEPS is low.
float ComputeNoiseMipFromDt(float stepLengthWorld, int baseDim, float periodXZ, float periodY) {
    float worldTexelXZ = periodXZ / float(baseDim);
    float worldTexelY  = periodY  / float(baseDim);
    float worldTexel   = max(worldTexelXZ, worldTexelY);

    float lod = log2(max(stepLengthWorld / max(worldTexel, 1e-6), 1e-6));
    lod = lod * u_noiseMipScale + u_noiseMipBias;

    float maxLevel = float(textureQueryLevels(uNoiseVol) - 1);
    lod = clamp(lod, max(u_noiseMinMip, 0.0), min(u_noiseMaxMip, maxLevel));
    return lod;
}

float ComputeNoiseMipFromDistance(float t) {
    float k = clamp((t - u_noiseMipNearDistance) / max(u_noiseMipFarDistance - u_noiseMipNearDistance, 1e-6), 0.0, 1.0);
    k = pow(k, max(u_noiseMipExponent, 1e-6));
    float lod = mix(u_noiseNearMip, u_noiseFarMip, k);

    float maxLevel = float(textureQueryLevels(uNoiseVol) - 1);
    lod = lod * u_noiseMipScale + u_noiseMipBias;
    lod = clamp(lod, max(u_noiseMinMip, 0.0), min(u_noiseMaxMip, maxLevel));
    return lod;
}

float ComputeNoiseScaleMultiplier(float t) {
    float k = clamp((t - u_noiseScaleStartDistance) / max(u_noiseScaleEndDistance - u_noiseScaleStartDistance, 1e-6), 0.0, 1.0);
    k = pow(k, max(u_noiseScaleExponent, 1e-6));
    return mix(u_noiseScaleNearMultiplier, u_noiseScaleFarMultiplier, k);
}

// Slab method for ray-AABB intersection
bool RayAABBIntersection(vec3 ro, vec3 rd, vec3 aabbMin, vec3 aabbMax, out float tNear, out float tFar) {
    vec3 invDir = 1.0 / rd;
    vec3 t0 = (aabbMin - ro) * invDir;
    vec3 t1 = (aabbMax - ro) * invDir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);

    tNear = max(tmin.x, max(tmin.y, tmin.z));
    tFar = min(tmax.x, min(tmax.y, tmax.z));

    return tFar >= max(tNear, 0.0);
}

float InterleavedGradientNoise(vec2 uv) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(uv, magic.xy)));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(OutputFogImage);
    if (px.x >= resolution.x || px.y >= resolution.y) return;

    if (u_fogEnabled == 0) {
        imageStore(OutputFogImage, px, vec4(0.0));
        return;
    }

    
    //imageStore(OutputFogImage, px, vec4(0));
    //return;

    ivec2 depthSize = textureSize(u_depthTexture, 0);
    ivec2 depthPx = clamp(ivec2((vec2(px) + 0.5) * vec2(depthSize) / vec2(resolution)), ivec2(0), depthSize - ivec2(1));
    uint viewportIndex = ViewportIndexFromPixel(depthPx, depthSize, rendererData.viewportLayout, vec2(rendererData.viewportSplitX, rendererData.viewportSplitY));

    // Ray setup
    vec3 origin = viewportData[viewportIndex].viewPos.xyz;
    ivec4 viewportRect = ivec4(viewportData[viewportIndex].xOffset, viewportData[viewportIndex].yOffset, viewportData[viewportIndex].width, viewportData[viewportIndex].height);
    vec2 viewportUV = ViewportUVFromPixel(depthPx, depthSize, viewportRect);
    // Depth reconstruction
    mat4 inverseProjectionViewReverseZ = viewportData[viewportIndex].inverseJitteredProjectionViewReverseZ;
    float depth = texelFetch(u_depthTexture, depthPx, 0).r;
    bool hasSceneDepth = depth > 1e-6;
    vec3 rayPoint = WorldPosFromDepth(viewportUV, 1.0, inverseProjectionViewReverseZ);
    vec3 dir = normalize(rayPoint - origin);

    // Calculate distances
    float totalDist = u_maxRayDistance;
    if (hasSceneDepth) {
        vec3 worldPos = WorldPosFromDepth(viewportUV, depth, inverseProjectionViewReverseZ);
        totalDist = max(dot(worldPos - origin, dir), 0.0);
    }
    float marchDist = min(totalDist, u_maxRayDistance); // How far we actually march
    int stepCount = clamp(u_stepCount, 1, MAX_FOG_STEPS);
    float adaptiveDt = marchDist / float(stepCount);

    vec3 accCol = vec3(0.0);
    float accAlpha = 0.0;

    // Jitter
    float jitter = InterleavedGradientNoise(vec2(px) + fract(u_time));

    // Precomputes
    int fogTextureSize = textureSize(uNoiseVol, 0).x;
    float timeScroll = fract(u_time * u_timeScrollSpeed / float(fogTextureSize));
    float xMorph = fract(u_time * u_xMorphSpeed / float(fogTextureSize));
    float zMorph = fract(u_time * u_zMorphSpeed / float(fogTextureSize));
    float yScroll = fract(u_time * u_yScrollSpeed / float(fogTextureSize));
    vec3 dynamicOffset = u_windVelocity * u_time;
    vec3 uvScale = vec3(1.0 / max(u_clumpSizeXZ, 1e-4), 1.0 / max(u_clumpSizeY, 1e-4), 1.0 / max(u_clumpSizeXZ, 1e-4));

    // AABB Skip
    vec3 aabbMin = vec3(34.0, 30.9, 33.0);
    vec3 aabbMax = vec3(44.1, 37.0, 42.0);
    float tNearAABB, tFarAABB;
    bool hitsHouse = false; // RayAABBIntersection(origin, dir, aabbMin, aabbMax, tNearAABB, tFarAABB);

    // RAYMARCHING LOOP (Near Fog)
    for (int i = 0; i < MAX_FOG_STEPS; ++i) {
        if (i >= stepCount) break;
        float t = adaptiveDt * (float(i) + jitter);
        if (t >= marchDist) break;

        if (hitsHouse && t > tNearAABB && t < tFarAABB) {
            i += int(floor((tFarAABB - t) / max(adaptiveDt, 1e-4)));
            continue;
        }

        vec3 raySamplePos = origin + dir * t;

        float noiseScaleMult = ComputeNoiseScaleMultiplier(t);
        float distanceNoiseMip = ComputeNoiseMipFromDistance(t);
        float stepNoiseMip = ComputeNoiseMipFromDt(adaptiveDt, fogTextureSize, u_clumpSizeXZ * noiseScaleMult, u_clumpSizeY * noiseScaleMult);
        float noiseMip = mix(distanceNoiseMip, max(distanceNoiseMip, stepNoiseMip), clamp(u_noiseMipRespectStep, 0.0, 1.0));
        noiseMip = clamp(noiseMip - log2(max(noiseScaleMult, 1e-6)), u_noiseMinMip, u_noiseMaxMip);

        vec3 baseUV = (raySamplePos + dynamicOffset) * (uvScale / max(noiseScaleMult, 1e-6));
        vec3 nuv1 = fract(baseUV + vec3(-xMorph + 0.1 + timeScroll, yScroll, zMorph + 0.1 + timeScroll));
        vec3 nuv2 = fract(baseUV + vec3(xMorph, -yScroll, -zMorph));
        float dens = (textureLod(uNoiseVol, nuv1, noiseMip).r + textureLod(uNoiseVol, nuv2, noiseMip).r) * 0.5;

        dens = max(dens - u_densityBias, 0.0) * u_densityScale * u_extinctionScale;
        float ext = exp(-dens * adaptiveDt);

        vec3 fLighting = vec3(0.0);
        //float fadeF = clamp((t - nearFadeFlashlight) / (farFadeFlashlight - nearFadeFlashlight), 0.0, 1.0);
        //if (fadeF > 1e-4 && rendererData.spotLightCount > 0u) {
        //    sampler2D flashlightIES = sampler2D(textureSamplers[max(rendererData.flashlightIESTextureIndex, 0)]);
        //    for (uint lightIndex = 0u; lightIndex < rendererData.spotLightCount; ++lightIndex) {
        //        float attenuation = GetSpotLightAttenuation(spotLights[lightIndex], rendererData, raySamplePos, flashlightIES);
        //        fLighting += attenuation * 0.5 * rendererData.flashlightColor.rgb;
        //    }
        //    fLighting *= fadeF;
        //}

        float fadeA = clamp((t - u_ambientStartDistance) / max(u_ambientEndDistance - u_ambientStartDistance, 1e-6), 0.0, 1.0);
        fadeA = pow(fadeA, max(u_ambientExponent, 1e-6));
        vec3 stepScatter = (vec3(fadeA) + fLighting) * (1.0 - ext);
        float heightBlend = clamp((raySamplePos.y - u_heightFadeStart) / max(u_heightFadeEnd - u_heightFadeStart, 1e-6), 0.0, 1.0);
        heightBlend = pow(heightBlend, max(u_heightExponent, 1e-6));
        stepScatter *= mix(u_lowHeightScatterMultiplier, 1.0, heightBlend);

        accCol += (1.0 - accAlpha) * stepScatter;
        accAlpha += (1.0 - accAlpha) * (1.0 - ext);

        if (accAlpha >= 0.99) break;
    }

    //accCol = vec3(0);
    //accAlpha = 1;

    vec3 fogRadiance = u_fogColor * u_fogColorStrength;
    accCol *= fogRadiance;

    if (hasSceneDepth && totalDist > u_distanceFogStart) {
        float dFog = clamp((totalDist - u_distanceFogStart) / max(u_distanceFogEnd - u_distanceFogStart, 1e-6), 0.0, 1.0);
        dFog = pow(smoothstep(0.0, 1.0, dFog), max(u_distanceFogExponent, 1e-6));
        dFog *= u_distanceFogStrength;

        accCol += (1.0 - accAlpha) * fogRadiance * dFog;
        accAlpha += (1.0 - accAlpha) * dFog;
    }

    imageStore(OutputFogImage, px, vec4(accCol, accAlpha));
}
