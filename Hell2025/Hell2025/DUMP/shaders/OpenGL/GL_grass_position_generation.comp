} drawCmd;

readonly layout(std430, binding = SSBO_IDX_VIEWPORT_DATA) buffer viewportDataBuffer { ViewportData viewportDataArr[]; };
layout(std430, binding = SSBO_IDX_GRASS_POSITION_INPUT_VERTICES) buffer inputVertexBuffer { Vertex InputVertexBuffer[]; };
layout(std430, binding = SSBO_IDX_GRASS_POSITION_INPUT_INDICES) buffer inputIndexBuffer { uint InputIndexBuffer[]; };
layout(std430, binding = SSBO_IDX_GRASS_POSITION_BLADE_POSITIONS) buffer BladePositions { vec4 bladePositions[]; };

uint HashGrassCell(ivec2 chunkCoord, ivec2 localCell, uint salt) {
    uint hash = uint(chunkCoord.x) * 0x8da6b343u;
    hash ^= uint(chunkCoord.y) * 0xd8163841u;
    hash ^= uint(localCell.x) * 0xcb1ab31fu;
    hash ^= uint(localCell.y) * 0x165667b1u;
    hash ^= salt;
    hash ^= hash >> 16u;
    hash *= 0x7feb352du;
    hash ^= hash >> 15u;
    hash *= 0x846ca68bu;
    hash ^= hash >> 16u;
    return hash;
}

float GrassCellNoise(ivec2 chunkCoord, ivec2 localCell, uint salt) {
    return float(HashGrassCell(chunkCoord, localCell, salt) >> 8u) * (1.0 / 16777216.0);
}

vec2 GrassCellJitter(ivec2 chunkCoord, ivec2 localCell) {
    return vec2(
        GrassCellNoise(chunkCoord, localCell, 0xa511e9b3u),
        GrassCellNoise(chunkCoord, localCell, 0x63d83595u)) - 0.5;
}

float SignedDistance(vec3 point, vec4 plane) {
    return dot(plane.xyz, point) + plane.w;
}

bool IntersectsPoint(vec3 point, int viewportIndex) {
    vec4 frustumPlanes[6];
    frustumPlanes[0] = viewportDataArr[viewportIndex].frustumPlane0;
    frustumPlanes[1] = viewportDataArr[viewportIndex].frustumPlane1;
    frustumPlanes[2] = viewportDataArr[viewportIndex].frustumPlane2;
    frustumPlanes[3] = viewportDataArr[viewportIndex].frustumPlane3;
    frustumPlanes[4] = viewportDataArr[viewportIndex].frustumPlane4;
    frustumPlanes[5] = viewportDataArr[viewportIndex].frustumPlane5;

    for (int i = 0; i < 6; i++) {
        float distance = SignedDistance(point, frustumPlanes[i]);
        if (distance < 0) { // Fully outside
            return false;
        }
    }
    return true;
}

bool IntersectsSphere(vec3 center, float radius, int viewportIndex) {
    vec4 P0 = viewportDataArr[viewportIndex].frustumPlane0;
    vec4 P1 = viewportDataArr[viewportIndex].frustumPlane1;
    vec4 P2 = viewportDataArr[viewportIndex].frustumPlane2;
    vec4 P3 = viewportDataArr[viewportIndex].frustumPlane3;
    vec4 P4 = viewportDataArr[viewportIndex].frustumPlane4;
    vec4 P5 = viewportDataArr[viewportIndex].frustumPlane5;
    if (SignedDistance(center, P0) < -radius) return false;
    if (SignedDistance(center, P1) < -radius) return false;
    if (SignedDistance(center, P2) < -radius) return false;
    if (SignedDistance(center, P3) < -radius) return false;
    if (SignedDistance(center, P4) < -radius) return false;
    if (SignedDistance(center, P5) < -radius) return false;
    return true;
}

uint RandomUInt(vec2 seedVec, uint max) {
    // Hash the vec2 into a uint
    uint seed = floatBitsToUint(seedVec.x) ^ floatBitsToUint(seedVec.y);
    seed ^= 2747636419u;
    seed *= 2654435761u;
    seed ^= seed >> 16;
    seed *= 2654435761u;
    seed ^= seed >> 16;

    // Map the result to range [0, max]
    return seed % (max + 1u);
}

ivec2 ClampTerrainCoord(ivec2 coord) {
    return clamp(coord, ivec2(0), textureSize(TerrainControlTexture, 0) - 1);
}

float GetTerrainHeight(ivec2 coord) {
    ivec2 maximumCoord = textureSize(HeightMapTexture, 0) - 1;
    return texelFetch(HeightMapTexture, clamp(coord, ivec2(0), maximumCoord), 0).r * HEIGHTMAP_SCALE_Y;
}

vec3 GetSmoothTerrainNormal(vec2 controlPosition) {
    ivec2 baseCoord = ivec2(floor(controlPosition));
    vec2 fractional = fract(controlPosition);
    vec2 inverseFractional = 1.0 - fractional;
    vec4 weights = vec4(
        inverseFractional.x * fractional.y,
        fractional.x * fractional.y,
        fractional.x * inverseFractional.y,
        inverseFractional.x * inverseFractional.y);

    float h[4];
    h[3] = GetTerrainHeight(baseCoord);
    h[2] = GetTerrainHeight(baseCoord + ivec2(1, 0));
    h[0] = GetTerrainHeight(baseCoord + ivec2(0, 1));
    h[1] = GetTerrainHeight(baseCoord + ivec2(1, 1));
    float h4 = GetTerrainHeight(baseCoord + ivec2(1, 2));
    float h5 = GetTerrainHeight(baseCoord + ivec2(2, 1));
    float h6 = GetTerrainHeight(baseCoord + ivec2(2, 0));
    float h7 = GetTerrainHeight(baseCoord + ivec2(0, 2));

    vec3 indexNormal[4];
    indexNormal[3] = normalize(vec3(h[3] - h[2], HEIGHTMAP_SCALE_XZ, h[3] - h[0]));
    indexNormal[0] = normalize(vec3(h[0] - h[1], HEIGHTMAP_SCALE_XZ, h[0] - h7));
    indexNormal[1] = normalize(vec3(h[1] - h5, HEIGHTMAP_SCALE_XZ, h[1] - h4));
    indexNormal[2] = normalize(vec3(h[2] - h6, HEIGHTMAP_SCALE_XZ, h[2] - h[1]));

    return normalize(
        indexNormal[0] * weights[0] +
        indexNormal[1] * weights[1] +
        indexNormal[2] * weights[2] +
        indexNormal[3] * weights[3]);
}

uint ResolveTerrainControl(uint control, float autoBlend) {
    if ((control & 0x1u) != 0u) {
        control =
            ((0u & 0x1Fu) << 27u) |
            ((2u & 0x1Fu) << 22u) |
            ((uint(fma(autoBlend, 255.0, 0.5)) & 0xFFu) << 14u);
    }
    return control;
}

float GetGrassCoverage(vec2 controlPosition) {
    ivec2 baseCoord = ivec2(floor(controlPosition));
    vec2 fractional = fract(controlPosition);
    vec2 inverseFractional = 1.0 - fractional;
    vec4 spatialWeights = vec4(
        inverseFractional.x * fractional.y,
        fractional.x * fractional.y,
        fractional.x * inverseFractional.y,
        inverseFractional.x * inverseFractional.y);
    ivec2 controlCoords[4] = ivec2[4](
        baseCoord + ivec2(0, 1),
        baseCoord + ivec2(1, 1),
        baseCoord + ivec2(1, 0),
        baseCoord);

    vec3 terrainNormal = GetSmoothTerrainNormal(controlPosition);
    float terrainSlope = 1.0 - clamp(terrainNormal.y, 0.0, 1.0);
    float autoBlend = smoothstep(0.15, 0.45, terrainSlope);
    float grassCoverage = 0.0;

    for (int i = 0; i < 4; i++) {
        uint control = texelFetch(TerrainControlTexture, ClampTerrainCoord(controlCoords[i]), 0).r;
        control = ResolveTerrainControl(control, autoBlend);

        uint baseMaterial = (control >> 27u) & 0x1Fu;
        uint overlayMaterial = (control >> 22u) & 0x1Fu;
        if (baseMaterial > 3u) baseMaterial = 0u;
        if (overlayMaterial > 3u) overlayMaterial = 0u;
        float overlayWeight = float((control >> 14u) & 0xFFu) / 255.0;
        float baseWeight = 1.0 - overlayWeight;
        float cornerGrassCoverage =
            (baseMaterial == 0u ? baseWeight : 0.0) +
            (overlayMaterial == 0u ? overlayWeight : 0.0);
        grassCoverage += cornerGrassCoverage * spatialWeights[i];
    }

    return clamp(grassCoverage, 0.0, 1.0);
}

void main() {
    // tweakables
    float bendStrength = 0.1;
    float bladeHeight = u_bladeHeight;
    float bottomWidth = 0.005;
    float topWidth = 0.002;

    int viewportIndex = u_viewportIndex;
    ivec2 depthSize = textureSize(u_depthTexture, 0);
    ivec4 viewportRect = ivec4(viewportDataArr[viewportIndex].xOffset, viewportDataArr[viewportIndex].yOffset, viewportDataArr[viewportIndex].width, viewportDataArr[viewportIndex].height);
    mat4 projectionView = viewportDataArr[viewportIndex].jitteredProjectionViewReverseZ;
    mat4 inverseProjectionView = viewportDataArr[viewportIndex].inverseJitteredProjectionViewReverseZ;
    vec3 viewPos = viewportDataArr[viewportIndex].viewPos.xyz;

    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= gridSize || gid.y >= gridSize) return;
    vec2 rootXZ = vec2(gid) * u_spacing + offset.xz;
    rootXZ += GrassCellJitter(u_chunkCoord, gid) * (u_spacing * 0.8);
    float posX = rootXZ.x;
    float posZ = rootXZ.y;

    vec2 controlPosition = vec2(posX, posZ) / HEIGHTMAP_SCALE_XZ;
    ivec2 terrainMaximum = textureSize(TerrainControlTexture, 0) - 1;
    if (any(lessThan(controlPosition, vec2(0.0))) || any(greaterThan(controlPosition, vec2(terrainMaximum)))) return;

    float grassCoverage = GetGrassCoverage(controlPosition);
    if (grassCoverage < clamp(u_grassCoverageThreshold, 0.0, 1.0)) return;
    if (GrassCellNoise(u_chunkCoord, gid, 0x9e3779b9u) >= grassCoverage) return;

    vec2 heightMapDimensions = textureSize(HeightMapTexture, 0) * HEIGHTMAP_SCALE_XZ;
    vec2 normalizedCoords = vec2(posX / heightMapDimensions.x, posZ / heightMapDimensions.y);
    vec2 texelSize = 1.0 / textureSize(HeightMapTexture, 0);
    float height = texture(HeightMapTexture, normalizedCoords + (texelSize * 0.5)).r;
    float roadMask = texture(RoadMaskTexture, normalizedCoords).r;

    float posY = height * HEIGHTMAP_SCALE_Y;

    // Skip road
    if (roadMask > 0.6) {
        return;
    }

    // Skip underwater
    if (posY < u_waterHeight) {
        return;
    }

    float rr = GrassCellNoise(u_chunkCoord, gid, 0xb5297a4du);
    float amt = 0.05;
    posY += rr * amt - (amt / 2);
    vec3 basePos = vec3(posX, posY, posZ);

    // Frustum cull
    if (!IntersectsSphere(basePos, bladeHeight * 10, viewportIndex)) {
        return;
    }

    vec4 clipPosition = projectionView * vec4(basePos, 1.0);
    if (clipPosition.w <= 0.0) return;

    vec2 projectedViewportUV = ViewportUVFromClipPosition(clipPosition);
    if (any(lessThan(projectedViewportUV, vec2(0.0))) || any(greaterThanEqual(projectedViewportUV, vec2(1.0)))) return;

    // Occlusion cull
    vec2 depthUV = ScreenUVFromViewportUV(projectedViewportUV, depthSize, viewportRect);
    float depth = texture(u_depthTexture, depthUV).r;
    vec3 sceneWorldPos = WorldPosFromDepth(projectedViewportUV, depth, inverseProjectionView);

    float sceneDistanceToCamera = length(sceneWorldPos - viewPos);
    float baseDistanceToCamera = length(basePos - viewPos);
    float boundingRadius = bladeHeight;

    if ((baseDistanceToCamera - boundingRadius) > sceneDistanceToCamera) {
        return;
    }

    // this may be faster?

    // float sceneDepth = texture(u_depthTexture, biasedScreenUV).r;
    //
    // // offset point toward camera by blade height bounding radius
    // vec3 dirToCamera = normalize(viewPos - basePos);
    // vec3 testPos = basePos + (dirToCamera * bladeHeight);
    //
    // // project to clip space
    // vec4 clipPos = projectionView * vec4(testPos, 1.0);
    // if (clipPos.w <= 0.0) return;
    //
    // float ndcZ = clipPos.z / clipPos.w;
    //
    // float grassDepth = ndcZ;
    // // if (grassDepth > sceneDepth) return;
    // // if (grassDepth < sceneDepth) return; // revere Z


    // Don't sample skybox
    //if (sceneWorldPos.x == 0.0 && sceneWorldPos.y == 0.0 && sceneWorldPos.z == 0.0) {
    //    return;
    //}

    // Jitter the positon
    //float jitterX = (Rand(vec2(basePos.x, basePos.z)) - 0.5) * 0.1;
    //float jitterZ = (Rand(vec2(basePos.z, basePos.x)) - 0.5) * 0.1;
    //basePos.x += jitterX;
    //basePos.z += jitterZ;

    // Append
    uint baseIndex = atomicAdd(drawCmd.count, uint(u_indicesPerBlade));
    uint indx = baseIndex / uint(u_indicesPerBlade);
    bladePositions[indx] = vec4(basePos, 0);
}
