#version 460 core
#include "../common/OpenGL/GL_binding_indices.glsl"
#include "../common/constants.glsl"
#include "../common/util.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D HeightMapTexture;
layout(binding = 1) uniform usampler2D TerrainControlTexture;
layout(binding = 3) uniform sampler2D RoadMaskTexture;

uniform int u_gridSize;
uniform int u_pointsPerChunk;
uniform int u_slotIndex;
uniform float u_spacing;
uniform ivec2 u_chunkCoord;
uniform vec3 u_chunkOffset;
uniform float u_waterHeight;
uniform float u_grassCoverageThreshold;

struct ChunkMetadata {
    ivec2 chunkCoord;
    uint pointCount;
    uint unused;
    vec4 boundsMin;
    vec4 boundsMax;
};

layout(std430, binding = SSBO_IDX_NEW_GRASS_CHUNK_METADATA) buffer GrassChunkMetadata {
    ChunkMetadata chunkMetadata[];
};

layout(std430, binding = SSBO_IDX_NEW_GRASS_CACHED_POINTS) buffer CachedGrassPoints {
    uvec2 cachedGrassPoints[];
};

uint HashGrassCell(ivec2 chunkCoord, ivec2 localCell, uint salt) {
    uint hash = uint(chunkCoord.x) * 0x8da6b343u;
    hash ^= uint(chunkCoord.y) * 0xd8163841u;
    hash ^= uint(localCell.x) * 0xcb1ab31fu;
    hash ^= uint(localCell.y) * 0x165667b1u;
    hash ^= salt;
    hash ^= hash >> 16u;
    hash *= 0x7feb352du;
    hash ^= hash >> 15u;
    hash *= 0x846ca68bu;
    hash ^= hash >> 16u;
    return hash;
}

float GrassCellNoise(ivec2 chunkCoord, ivec2 localCell, uint salt) {
    return float(HashGrassCell(chunkCoord, localCell, salt) >> 8u) * (1.0 / 16777216.0);
}

vec2 GrassCellJitter(ivec2 chunkCoord, ivec2 localCell) {
    return vec2(
        GrassCellNoise(chunkCoord, localCell, 0xa511e9b3u),
        GrassCellNoise(chunkCoord, localCell, 0x63d83595u)) - 0.5;
}

ivec2 ClampTerrainCoord(ivec2 coord) {
    return clamp(coord, ivec2(0), textureSize(TerrainControlTexture, 0) - 1);
}

float GetTerrainHeight(ivec2 coord) {
    ivec2 maximumCoord = textureSize(HeightMapTexture, 0) - 1;
    return texelFetch(HeightMapTexture, clamp(coord, ivec2(0), maximumCoord), 0).r * HEIGHTMAP_SCALE_Y;
}

vec3 GetSmoothTerrainNormal(vec2 controlPosition) {
    ivec2 baseCoord = ivec2(floor(controlPosition));
    vec2 fractional = fract(controlPosition);
    vec2 inverseFractional = 1.0 - fractional;
    vec4 weights = vec4(
        inverseFractional.x * fractional.y,
        fractional.x * fractional.y,
        fractional.x * inverseFractional.y,
        inverseFractional.x * inverseFractional.y);

    float h[4];
    h[3] = GetTerrainHeight(baseCoord);
    h[2] = GetTerrainHeight(baseCoord + ivec2(1, 0));
    h[0] = GetTerrainHeight(baseCoord + ivec2(0, 1));
    h[1] = GetTerrainHeight(baseCoord + ivec2(1, 1));
    float h4 = GetTerrainHeight(baseCoord + ivec2(1, 2));
    float h5 = GetTerrainHeight(baseCoord + ivec2(2, 1));
    float h6 = GetTerrainHeight(baseCoord + ivec2(2, 0));
    float h7 = GetTerrainHeight(baseCoord + ivec2(0, 2));

    vec3 indexNormal[4];
    indexNormal[3] = normalize(vec3(h[3] - h[2], HEIGHTMAP_SCALE_XZ, h[3] - h[0]));
    indexNormal[0] = normalize(vec3(h[0] - h[1], HEIGHTMAP_SCALE_XZ, h[0] - h7));
    indexNormal[1] = normalize(vec3(h[1] - h5, HEIGHTMAP_SCALE_XZ, h[1] - h4));
    indexNormal[2] = normalize(vec3(h[2] - h6, HEIGHTMAP_SCALE_XZ, h[2] - h[1]));

    return normalize(
        indexNormal[0] * weights[0] +
        indexNormal[1] * weights[1] +
        indexNormal[2] * weights[2] +
        indexNormal[3] * weights[3]);
}

uint ResolveTerrainControl(uint control, float autoBlend) {
    if ((control & 0x1u) != 0u) {
        control =
            ((0u & 0x1Fu) << 27u) |
            ((2u & 0x1Fu) << 22u) |
            ((uint(fma(autoBlend, 255.0, 0.5)) & 0xFFu) << 14u);
    }
    return control;
}

float GetGrassCoverage(vec2 controlPosition) {
    ivec2 baseCoord = ivec2(floor(controlPosition));
    vec2 fractional = fract(controlPosition);
    vec2 inverseFractional = 1.0 - fractional;
    vec4 spatialWeights = vec4(
        inverseFractional.x * fractional.y,
        fractional.x * fractional.y,
        fractional.x * inverseFractional.y,
        inverseFractional.x * inverseFractional.y);
    ivec2 controlCoords[4] = ivec2[4](
        baseCoord + ivec2(0, 1),
        baseCoord + ivec2(1, 1),
        baseCoord + ivec2(1, 0),
        baseCoord);

    vec3 terrainNormal = GetSmoothTerrainNormal(controlPosition);
    float terrainSlope = 1.0 - clamp(terrainNormal.y, 0.0, 1.0);
    float autoBlend = smoothstep(0.15, 0.45, terrainSlope);
    float grassCoverage = 0.0;

    for (int i = 0; i < 4; i++) {
        uint control = texelFetch(TerrainControlTexture, ClampTerrainCoord(controlCoords[i]), 0).r;
        control = ResolveTerrainControl(control, autoBlend);

        uint baseMaterial = (control >> 27u) & 0x1Fu;
        uint overlayMaterial = (control >> 22u) & 0x1Fu;
        if (baseMaterial > 3u) baseMaterial = 0u;
        if (overlayMaterial > 3u) overlayMaterial = 0u;
        float overlayWeight = float((control >> 14u) & 0xFFu) / 255.0;
        float baseWeight = 1.0 - overlayWeight;
        float cornerGrassCoverage =
            (baseMaterial == 0u ? baseWeight : 0.0) +
            (overlayMaterial == 0u ? overlayWeight : 0.0);
        grassCoverage += cornerGrassCoverage * spatialWeights[i];
    }

    return clamp(grassCoverage, 0.0, 1.0);
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= u_gridSize || gid.y >= u_gridSize) return;

    vec2 rootXZ = vec2(gid) * u_spacing + u_chunkOffset.xz;
    rootXZ += GrassCellJitter(u_chunkCoord, gid) * (u_spacing * 0.8);
    float posX = rootXZ.x;
    float posZ = rootXZ.y;

    vec2 controlPosition = vec2(posX, posZ) / HEIGHTMAP_SCALE_XZ;
    ivec2 terrainMaximum = textureSize(TerrainControlTexture, 0) - 1;
    if (any(lessThan(controlPosition, vec2(0.0))) || any(greaterThan(controlPosition, vec2(terrainMaximum)))) return;

    float grassCoverage = GetGrassCoverage(controlPosition);
    if (grassCoverage < clamp(u_grassCoverageThreshold, 0.0, 1.0)) return;
    if (GrassCellNoise(u_chunkCoord, gid, 0x9e3779b9u) >= grassCoverage) return;

    vec2 heightMapDimensions = textureSize(HeightMapTexture, 0) * HEIGHTMAP_SCALE_XZ;
    vec2 normalizedCoords = vec2(posX / heightMapDimensions.x, posZ / heightMapDimensions.y);
    vec2 texelSize = 1.0 / textureSize(HeightMapTexture, 0);
    float height = texture(HeightMapTexture, normalizedCoords + texelSize * 0.5).r;
    float roadMask = texture(RoadMaskTexture, normalizedCoords).r;

    float posY = height * HEIGHTMAP_SCALE_Y;
    if (roadMask > 0.6) return;
    if (posY < u_waterHeight) return;

    float heightJitter = GrassCellNoise(u_chunkCoord, gid, 0xb5297a4du) * 0.05 - 0.025;
    posY += heightJitter;

    uint pointIndex = atomicAdd(chunkMetadata[u_slotIndex].pointCount, 1u);
    uint outputIndex = uint(u_slotIndex * u_pointsPerChunk) + pointIndex;
    uint localGridIndex = uint(gid.y * u_gridSize + gid.x);
    cachedGrassPoints[outputIndex] = uvec2(localGridIndex, floatBitsToUint(posY));
}
