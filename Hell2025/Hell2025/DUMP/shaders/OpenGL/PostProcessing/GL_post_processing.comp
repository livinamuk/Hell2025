#version 430
#include "../../common/OpenGL/GL_binding_indices.glsl"
#include "../../common/post_processing.glsl"
#include "../../common/types.glsl"
#include "../../common/util.glsl"
#include "../../common/viewport.glsl"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform image2D u_outputImage;
layout(rgba16f, binding = 1) uniform image2D u_inputImage;

readonly restrict layout(std430, binding = SSBO_IDX_RENDERER_DATA) buffer rendererDataBuffer { RendererData rendererData; };
readonly restrict layout(std430, binding = SSBO_IDX_VIEWPORT_DATA) buffer viewportDataBuffer { ViewportData viewportData[]; };

vec3 ACES(vec3 x) {
    const float a=2.51, b=0.03, c=2.43, d=0.59, e=0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 sat(vec3 c, float s) {
    float Y = luma(c);
    return mix(vec3(Y), c, s);
}

vec3 softContrast(vec3 c, float k) {
    float m = 0.5;
    return mix(m + (c - m) * (1.0 + (k - 1.0)), c, 0.0);
}

vec3 ApplyVignette(vec3 inputColor, vec3 vignetteColor, float intensityScalar, vec2 uv) {
    float vignetteSize = 0.75;
    float vignetteShape = 1.0;
    float vignetteSmoothness = 0.845;

    vec2 centeredUv = uv - 0.5;
    centeredUv.x *= vignetteShape;
    float dist = length(centeredUv);
    float mask = smoothstep(vignetteSize, vignetteSize - vignetteSmoothness, dist);
    float blend = (1.0 - mask) * intensityScalar;
    return mix(inputColor, vignetteColor, blend);
}

// pass in pre-computed data to avoid redundant imageLoad and math
vec3 RE(vec3 lighting, vec2 uv_screenspace, ivec2 pixelCoords, uint viewportIndex, vec3 colorTint, float contrast) {
    vec2 outputImageSize = vec2(imageSize(u_outputImage));
    vec3 finalColor = lighting;


    finalColor = Tonemap_ACES(lighting);
    finalColor = pow(finalColor, vec3(1.0 / 2.2));
    finalColor = clamp(finalColor, 0.0, 1.0);

    float Y = luma(finalColor);
    float sh = smoothstep(0.60, 0.20, Y);
    float mi = smoothstep(0.15, 0.65, Y) * (1.0 - smoothstep(0.70, 0.95, Y));
    float hi = smoothstep(0.55, 0.95, Y);

    float blackProtectEdge = 0.2;
    float protect = smoothstep(0.0, blackProtectEdge, Y);

    vec3 shadowTint = vec3(0.20, 0.30, 0.55);
    vec3 highlightTint = vec3(1.03, 0.98, 0.95);
    float bleach = 0.2;
    float blueAir = 0.48;

    vec3 delta = vec3(0.0);
    delta += (shadowTint * 0.22) * sh * protect;
    finalColor *= mix(vec3(1.0), highlightTint, hi * 0.12 * protect);

    float grayBP = dot(finalColor, vec3(0.299, 0.587, 0.114));
    vec3 maxc = max(finalColor, vec3(grayBP));
    finalColor = mix(finalColor, maxc, bleach * protect);

    delta += vec3(0.10, 0.16, 0.35) * blueAir * mi;
    finalColor += delta * protect;

    float k = 0.92;
    float m = 0.18;

    finalColor = mix(finalColor, m + (finalColor - m) * (1.0 + (k - 1.0)), protect);
    finalColor *= colorTint;
    finalColor.rgb = AdjustContrast(finalColor.rgb, contrast);

    return finalColor;
}

vec3 OG(vec3 lighting, vec2 uv_screenspace, ivec2 pixelCoords, uint viewportIndex, vec3 colorTint, float contrast) {
    vec2 outputImageSize = vec2(imageSize(u_outputImage));
    vec3 finalColor = lighting;
    vec3 colorTintCursed = colorTint.rgb * vec3(1, 0.925, 0.925);

    finalColor = Tonemap_ACES(lighting);
    finalColor = pow(finalColor, vec3(1.0 / 2.2));
    finalColor = clamp(finalColor, 0, 1);
    finalColor = mix(finalColor, Tonemap_ACES(finalColor), 0.125);

    finalColor *= colorTintCursed;
    finalColor.rgb = AdjustContrast(finalColor.rgb, contrast);

    float gray = dot(finalColor.rgb, vec3(0.299, 0.587, 0.114));
    return mix(finalColor.rgb, vec3(gray), 0.0);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputImageSize = imageSize(u_outputImage);
    vec2 outputSize = vec2(outputImageSize);

    if (px.x >= int(outputSize.x) || px.y >= int(outputSize.y)) return;

    vec2 uv = (vec2(px) + 0.5) / outputSize;
    vec3 rawLighting = imageLoad(u_inputImage, px).rgb;
    uint viewportIndex = ViewportIndexFromPixel(px, outputImageSize, rendererData.viewportLayout, vec2(rendererData.viewportSplitX, rendererData.viewportSplitY));

    if (!IsViewportActive(viewportIndex, rendererData.activeViewportMask)) {
        imageStore(u_outputImage, px, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    ivec4 viewportRect = ivec4(viewportData[viewportIndex].xOffset, viewportData[viewportIndex].yOffset, viewportData[viewportIndex].width, viewportData[viewportIndex].height);
    float contrast = viewportData[viewportIndex].colorContrast;
    vec3 colorTint = viewportData[viewportIndex].colorTint.rgb;

    // compute the two looks
    vec3 ogLook = OG(rawLighting, uv, px, viewportIndex, colorTint, contrast);
    vec3 reLook = RE(rawLighting, uv, px, viewportIndex, colorTint, contrast);

    // blend and apply brightness hack
    vec3 finalColor = mix(ogLook, reLook, 0.25);
    finalColor += vec3(0.0125);
    
    vec2 viewportUV = ViewportUVFromPixel(px, outputImageSize, viewportRect);

    //finalColor = ogLook;

    // vignette setup
    finalColor = ApplyVignette(finalColor, viewportData[viewportIndex].vignetteColor.rgb, viewportData[viewportIndex].intensityScalar * 0.5, viewportUV);

    // This is display-referred color from here onward. Keep it normalized
    // before UI alpha blending; floating-point presentation targets otherwise
    // preserve negative death-tint/contrast values that contaminate UI color.
    finalColor = clamp(finalColor, vec3(0.0), vec3(1.0));

    imageStore(u_outputImage, px, vec4(finalColor, 1));
    //imageStore(u_outputImage, pixelCoords, vec4(rawLighting, 1));
}
