#version 460
#extension GL_ARB_bindless_texture : require

#include "../../common/constants.glsl"
#include "../../common/terrain_projection.glsl"
#include "../../common/types.glsl"
#include "../../common/OpenGL/GL_binding_indices.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2DArray u_DisplacementBuffer;
layout(binding = 0) uniform sampler2D u_HeightMapTexture;
layout(binding = 1) uniform usampler2D u_TerrainControlTexture;

readonly restrict layout(std430, binding = SSBO_IDX_SAMPLERS) buffer textureSamplersBuffer { uvec2 textureSamplers[]; };
readonly restrict layout(std430, binding = SSBO_IDX_MATERIALS) buffer materialsBuffer { Material materials[]; };
readonly restrict layout(std430, binding = SSBO_IDX_VIEWPORT_DATA) buffer viewportDataBuffer { ViewportData viewportDataArr[]; };

uniform int u_terrainMaterial0;
uniform int u_terrainMaterial1;
uniform int u_terrainMaterial2;
uniform int u_terrainMaterial3;
uniform float u_textureScaling;
uniform float blend_sharpness = 0.5;
uniform float u_displacementSharpness = 0.25;

struct DisplacementMaterial {
    float height;
    float totalWeight;
};

int GetTerrainMaterialIndex(uint materialId) {
    if (materialId == 1u) return u_terrainMaterial1;
    if (materialId == 2u) return u_terrainMaterial2;
    if (materialId == 3u) return u_terrainMaterial3;
    return u_terrainMaterial0;
}

float GetTerrainUvScale(uint materialId) {
    return materialId == 1u ? 2.0 : 1.0;
}

ivec2 ClampHeightCoord(ivec2 coord) {
    return clamp(coord, ivec2(0), textureSize(u_HeightMapTexture, 0) - 1);
}

float GetTerrainHeight(ivec2 coord) {
    return texelFetch(u_HeightMapTexture, ClampHeightCoord(coord), 0).r * HEIGHTMAP_SCALE_Y;
}

uint ResolveAutoControl(uint control, vec3 terrainNormal) {
    if ((control & 0x1u) == 0u) return control;
    float slope = 1.0 - clamp(terrainNormal.y, 0.0, 1.0);
    float autoBlend = smoothstep(0.15, 0.45, slope);
    return
        ((0u & 0x1Fu) << 27u) |
        ((2u & 0x1Fu) << 22u) |
        ((uint(fma(autoBlend, 255.0, 0.5)) & 0xFFu) << 14u);
}

void AccumulateDisplacementMaterial(
    mat3 tbn,
    float weight,
    uint control,
    vec2 textureWeight,
    ivec2 textureId,
    vec3 terrainTexturePosition,
    vec3 terrainNormal,
    inout DisplacementMaterial result) {

    // These are the identity values for Terrain3D control rotation/scale. The
    // local control texture currently stores IDs, blend and auto only.
    const float controlScale = 1.0;
    float worldNormal = 1.0;
    float blend = float((control >> 14u) & 0xFFu) / 255.0;
    float sharpness = fma(60.0, blend_sharpness * u_displacementSharpness, 4.0);

    if (blend < 1.0) {
        uint id = uint(textureId.x);
        float idWeightInput = textureWeight.x;
        float idScale = GetTerrainUvScale(id);
        Material material = materials[GetTerrainMaterialIndex(id)];
        vec2 projectedUv;
        vec2 unusedDPdx;
        vec2 unusedDPdy;
        mat2 projectedNormalAlignment;
        bool verticallyProjected = GetTerrainTextureProjection(
            id,
            terrainTexturePosition,
            terrainNormal,
            vec3(0.0),
            vec3(0.0),
            projectedUv,
            unusedDPdx,
            unusedDPdy,
            projectedNormalAlignment);
        vec2 idUv = projectedUv * idScale;

        float h = textureLod(sampler2D(textureSamplers[material.disp]), idUv, 0.0).r;
        vec3 normalMap = fma(textureLod(sampler2D(textureSamplers[material.normal]), idUv, 0.0).xyz, vec3(2.0), vec3(-1.0));
        if (verticallyProjected) {
            normalMap = normalize(normalMap);
            normalMap.xy = normalMap.xy * projectedNormalAlignment;
        }
        worldNormal = normalize(tbn * normalMap).y;

        float idWeight = exp2(sharpness * log2(weight + idWeightInput + h)) * weight;

        // Terrain3D applies asset scale/offset only after material weighting.
        float heightScale = (material.displacementScale * 0.04) / (controlScale * idScale);
        float heightOffset = 0.5 + material.displacementOffset * heightScale - 0.5 * heightScale;
        h = clamp(fma(h, heightScale, heightOffset), 0.0, 1.0);

        result.height = fma(h, idWeight, result.height);
        result.totalWeight += idWeight;
    }

    if (blend > 0.0 && textureId.y != textureId.x) {
        uint id = uint(textureId.y);
        float idWeightInput = textureWeight.y;
        float idScale = GetTerrainUvScale(id);
        Material material = materials[GetTerrainMaterialIndex(id)];
        vec2 projectedUv;
        vec2 unusedDPdx;
        vec2 unusedDPdy;
        mat2 unusedNormalAlignment;
        bool unusedProjection = GetTerrainTextureProjection(
            id,
            terrainTexturePosition,
            terrainNormal,
            vec3(0.0),
            vec3(0.0),
            projectedUv,
            unusedDPdx,
            unusedDPdy,
            unusedNormalAlignment);
        vec2 idUv = projectedUv * idScale;

        float h = textureLod(sampler2D(textureSamplers[material.disp]), idUv, 0.0).r;
        float idWeight = exp2(sharpness * log2(weight + idWeightInput + h * clamp(worldNormal, 0.0, 1.0))) * weight;

        float heightScale = (material.displacementScale * 0.04) / (controlScale * idScale);
        float heightOffset = 0.5 + material.displacementOffset * heightScale - 0.5 * heightScale;
        h = clamp(fma(h, heightScale, heightOffset), 0.0, 1.0);

        result.height = fma(h, idWeight, result.height);
        result.totalWeight += idWeight;
    }
}

void main() {
    ivec3 outputCoord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 outputSize = imageSize(u_DisplacementBuffer);
    if (any(greaterThanEqual(outputCoord, outputSize))) return;

    int level = outputCoord.x / int(TERRAIN_DISPLACEMENT_MESH_SIZE * 4.0);
    if (level >= TERRAIN_DISPLACEMENT_TESSELLATION_LEVEL) return;

    vec2 stripPixel = vec2(
        outputCoord.x - level * int(TERRAIN_DISPLACEMENT_MESH_SIZE * 4.0),
        outputCoord.y) + 0.5;
    vec2 stripUv = stripPixel / vec2(TERRAIN_DISPLACEMENT_MESH_SIZE * 4.0);
    float levelScale = exp2(float(level));
    vec2 targetControlPosition = viewportDataArr[outputCoord.z].viewPos.xz / HEIGHTMAP_SCALE_XZ;

    // This is Terrain3D's displacement-buffer coordinate transform: one
    // horizontal strip per clipmap/tessellation density.
    vec2 controlPosition = (stripUv - 0.5) * (TERRAIN_DISPLACEMENT_MESH_SIZE * 2.0) / levelScale;
    controlPosition += round(targetControlPosition * levelScale) / levelScale;

    ivec2 mapMaximum = textureSize(u_HeightMapTexture, 0) - 1;
    if (any(lessThan(controlPosition, vec2(0.0))) || any(greaterThan(controlPosition, vec2(mapMaximum)))) {
        imageStore(u_DisplacementBuffer, outputCoord, vec4(0.5, 0.5, 0.5, 1.0));
        return;
    }

    ivec2 baseCoord = ivec2(floor(controlPosition));
    vec2 fractional = fract(controlPosition);
    vec2 inverseFractional = 1.0 - fractional;
    vec4 spatialWeights = vec4(
        inverseFractional.x * fractional.y,
        fractional.x * fractional.y,
        fractional.x * inverseFractional.y,
        inverseFractional.x * inverseFractional.y);
    ivec2 coords[4] = ivec2[4](
        baseCoord + ivec2(0, 1),
        baseCoord + ivec2(1, 1),
        baseCoord + ivec2(1, 0),
        baseCoord);

    float h[4];
    h[3] = GetTerrainHeight(baseCoord);
    h[2] = GetTerrainHeight(baseCoord + ivec2(1, 0));
    h[0] = GetTerrainHeight(baseCoord + ivec2(0, 1));
    h[1] = GetTerrainHeight(baseCoord + ivec2(1, 1));
    float h4 = GetTerrainHeight(baseCoord + ivec2(1, 2));
    float h5 = GetTerrainHeight(baseCoord + ivec2(2, 1));
    float h6 = GetTerrainHeight(baseCoord + ivec2(2, 0));
    float h7 = GetTerrainHeight(baseCoord + ivec2(0, 2));

    vec3 indexNormal[4];
    indexNormal[3] = normalize(vec3(h[3] - h[2], HEIGHTMAP_SCALE_XZ, h[3] - h[0]));
    indexNormal[0] = normalize(vec3(h[0] - h[1], HEIGHTMAP_SCALE_XZ, h[0] - h7));
    indexNormal[1] = normalize(vec3(h[1] - h5, HEIGHTMAP_SCALE_XZ, h[1] - h4));
    indexNormal[2] = normalize(vec3(h[2] - h6, HEIGHTMAP_SCALE_XZ, h[2] - h[1]));

    vec3 worldNormal = normalize(
        indexNormal[0] * spatialWeights[0] +
        indexNormal[1] * spatialWeights[1] +
        indexNormal[2] * spatialWeights[2] +
        indexNormal[3] * spatialWeights[3]);
    vec3 worldTangent = normalize(cross(worldNormal, vec3(0.0, 0.0, 1.0)));
    vec3 worldBinormal = normalize(cross(worldNormal, worldTangent));
    mat3 tbn = mat3(worldTangent, worldBinormal, worldNormal);

    uint controls[4];
    ivec2 textureIds[4];
    vec2 textureWeights[4];
    vec4 weightsId1;
    vec4 weightsId0;
    for (int i = 0; i < 4; i++) {
        controls[i] = texelFetch(u_TerrainControlTexture, ClampHeightCoord(coords[i]), 0).r;
        controls[i] = ResolveAutoControl(controls[i], indexNormal[i]);

        uint baseId = (controls[i] >> 27u) & 0x1Fu;
        uint overlayId = (controls[i] >> 22u) & 0x1Fu;
        if (baseId > 3u) baseId = 0u;
        if (overlayId > 3u) overlayId = 0u;
        textureIds[i] = ivec2(baseId, overlayId);
        weightsId1[i] = float((controls[i] >> 14u) & 0xFFu) / 255.0;
        weightsId0[i] = 1.0 - weightsId1[i];
        textureWeights[i] = vec2(weightsId0[i], weightsId1[i]);
    }

    weightsId0 *= spatialWeights;
    weightsId1 *= spatialWeights;
    for (int target = 0; target < 4; target++) {
        textureWeights[target] = vec2(0.0);
        for (int source = 0; source < 4; source++) {
            vec2 weight0 = vec2(weightsId0[source]);
            vec2 weight1 = vec2(weightsId1[source]);
            textureWeights[target] += fma(
                weight0,
                vec2(equal(textureIds[target], textureIds[source].xx)),
                weight1 * vec2(equal(textureIds[target], textureIds[source].yy)));
        }
    }

    float terrainHeight =
        h[0] * spatialWeights[0] +
        h[1] * spatialWeights[1] +
        h[2] * spatialWeights[2] +
        h[3] * spatialWeights[3];
    vec2 baseUv = controlPosition / vec2(max(mapMaximum, ivec2(1)));
    float textureRepeat = 50.0 * u_textureScaling;
    float textureWorldScale = textureRepeat / (float(max(mapMaximum.x, 1)) * HEIGHTMAP_SCALE_XZ);
    vec3 terrainTexturePosition = vec3(baseUv.x * textureRepeat, terrainHeight * textureWorldScale, baseUv.y * textureRepeat);
    DisplacementMaterial result = DisplacementMaterial(0.0, 0.0);
    AccumulateDisplacementMaterial(tbn, spatialWeights[3], controls[3], textureWeights[3], textureIds[3], terrainTexturePosition, indexNormal[3], result);
    AccumulateDisplacementMaterial(tbn, spatialWeights[2], controls[2], textureWeights[2], textureIds[2], terrainTexturePosition, indexNormal[2], result);
    AccumulateDisplacementMaterial(tbn, spatialWeights[1], controls[1], textureWeights[1], textureIds[1], terrainTexturePosition, indexNormal[1], result);
    AccumulateDisplacementMaterial(tbn, spatialWeights[0], controls[0], textureWeights[0], textureIds[0], terrainTexturePosition, indexNormal[0], result);

    result.height *= 1.0 / max(result.totalWeight, 1e-8);
    vec3 encodedDisplacement = clamp(fma(worldNormal * (result.height - 0.5) * 2.0, vec3(0.5), vec3(0.5)), 0.0, 1.0);
    imageStore(u_DisplacementBuffer, outputCoord, vec4(encodedDisplacement, 1.0));
}
