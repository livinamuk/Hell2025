vec3 GetCameraNdotL(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    uint viewportIndex = ViewportIndexFromPixel(px, outputImageSize, rendererData.viewportLayout, vec2(rendererData.viewportSplitX, rendererData.viewportSplitY));
    mat4 inverseView = viewportDataArr[viewportIndex].inverseView;

    vec3 normal = GetNormal(px);
    vec3 lightDir = normalize(inverseView[2].xyz);
    float ndotl = max(dot(normal.xyz, lightDir), 0.0);

    return GetBaseColor(px) * ndotl;
    //return vec3(ndotl);
}

vec3 GetIndirectDiffuse(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    vec2 screenUV = ScreenUVFromPixel(px, outputImageSize);
    vec3 indirectDiffuseTexture =  texture(IndirectDiffuseTexture, screenUV).rgb;
    vec3 result = Tonemap_ACES(indirectDiffuseTexture);
    result = pow(result, vec3(1.0 / 2.2));
    result = clamp(result, 0, 1);
    result = mix(result, Tonemap_ACES(result), 0.125);
    return (result);
}

vec3 GetVelocity(ivec2 px) {
    vec2 velocity = vec2(0);
    //#if defined(RE_ENABLED)
        velocity = texelFetch(VelocityXYOcclusionSubSurface, px, 0).rg * 0.5;
    //#else
    //    velocity = texelFetch(VelocityOcclusionSubSurface, px, 0).rg;
    //#endif
    float gain = 20.0;
    return vec3(velocity * gain + 0.5, 0.5);
}

vec3 GetVisBuffer(ivec2 px) {
    #if defined(RE_ENABLED)
    uvec2 visibilityData = texelFetch(VisibilityTexture, px, 0).rg;
    #else
    uvec2 visibilityData = uvec2(0, 0);
    #endif

    uint meshID = visibilityData.x;
    uint primitiveID = visibilityData.y;

    // Check if background pixel
    if (meshID == 0 && primitiveID == 0) {
        return vec3(0.05, 0.05, 0.05);
    }

    // Generate distinctive color configurations
    vec3 meshColor = IntegerToColor(meshID);
    vec3 primColor = IntegerToColor(primitiveID);

    // Combine paths to highlight distinct meshes while showing individual triangles
    return mix(meshColor, primColor, 0.2);
}

vec3 GetVisBufferUVs(ivec2 px) {
    #if defined(RE_ENABLED)
    uvec2 visibilityData = texelFetch(VisibilityTexture, px, 0).rg;

    #else
    return vec3(0, 0, 0);
    #endif

    return vec3(0, 0, 0);
}

vec3 GetDepth(ivec2 px) {
    float depth = texelFetch(u_depthTexture, px, 0).r;
    return vec3(depth, 0, 0);
}

vec3 GetWorldPosition(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    uint viewportIndex = ViewportIndexFromPixel(px, outputImageSize, rendererData.viewportLayout, vec2(rendererData.viewportSplitX, rendererData.viewportSplitY));
    ivec4 viewportRect = ivec4(viewportDataArr[viewportIndex].xOffset, viewportDataArr[viewportIndex].yOffset, viewportDataArr[viewportIndex].width, viewportDataArr[viewportIndex].height);
    vec2 viewportUV = ViewportUVFromPixel(px, outputImageSize, viewportRect);
    mat4 inverseProjectionViewReverseZ = viewportDataArr[viewportIndex].inverseJitteredProjectionViewReverseZ;

    float depth = texelFetch(u_depthTexture, px, 0).r;
    return WorldPosFromDepth(viewportUV, depth, inverseProjectionViewReverseZ);
}

vec3 GetEmissive(ivec2 px) {
    return texelFetch(u_emissiveTexture, px, 0).rgb;
}

vec3 GetOcclusionHiZ(ivec2 px) {
    ivec2 outputImageSize = imageSize(u_outputImage);
    vec2 screenUV = ScreenUVFromPixel(px, outputImageSize);
    vec2 tiledUV = screenUV * 2.0;
    ivec2 tile = clamp(ivec2(floor(tiledUV)), ivec2(0), ivec2(1));
    vec2 localUV = fract(tiledUV);

    // Top-left/right and bottom-left/right show mips 0, 2, 4, and 6.
    float requestedMip = float((tile.x + tile.y * 2) * 2);
    float maxMip = float(max(textureQueryLevels(u_occlusionHiZTexture) - 1, 0));
    float reverseDepth = textureLod(u_occlusionHiZTexture, localUV, min(requestedMip, maxMip)).r;

    // Lift distant reverse-Z values for display only. The texture remains linear R32F.
    return vec3(pow(clamp(reverseDepth, 0.0, 1.0), 0.25));
}

void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputImageSize = imageSize(u_outputImage);
    if (px.x >= outputImageSize.x || px.y >= outputImageSize.y) return;

    uint viewportIndex = ViewportIndexFromPixel(px, outputImageSize, rendererData.viewportLayout, vec2(rendererData.viewportSplitX, rendererData.viewportSplitY));
    if (!IsViewportActive(viewportIndex, rendererData.activeViewportMask)) {
        imageStore(u_outputImage, px, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec3 finalColor = vec3(0, 0, 0);

    if (rendererData.rendererOverrideState == OVERRIDE_BASE_COLOR)       finalColor = GetBaseColor(px);
    if (rendererData.rendererOverrideState == OVERRIDE_NORMALS)          finalColor = GetNormal(px);
    if (rendererData.rendererOverrideState == OVERRIDE_RMA)              finalColor = GetRMA(px);
    if (rendererData.rendererOverrideState == OVERRIDE_ROUGHNESS)        finalColor = GetRoughness(px);
    if (rendererData.rendererOverrideState == OVERRIDE_METALLIC)         finalColor = GetMetallic(px);
    if (rendererData.rendererOverrideState == OVERRIDE_AO)               finalColor = GetAO(px);
    if (rendererData.rendererOverrideState == OVERRIDE_CAMERA_NDOTL)     finalColor = GetCameraNdotL(px);
    if (rendererData.rendererOverrideState == OVERRIDE_INDIRECT_DIFFUSE) finalColor = GetIndirectDiffuse(px);
    if (rendererData.rendererOverrideState == OVERRIDE_VELOCITY)         finalColor = GetVelocity(px);
    if (rendererData.rendererOverrideState == OVERRIDE_VIS_BUFFER)       finalColor = GetVisBuffer(px);
    if (rendererData.rendererOverrideState == OVERRIDE_DEPTH)            finalColor = GetDepth(px);
    if (rendererData.rendererOverrideState == OVERRIDE_WORLD_POSITION)   finalColor = GetWorldPosition(px);
    if (rendererData.rendererOverrideState == OVERRIDE_EMISSIVE)         finalColor = GetEmissive(px);
    if (rendererData.rendererOverrideState == OVERRIDE_OCCLUSION_HIZ)    finalColor = GetOcclusionHiZ(px);

    imageStore(u_outputImage, px, vec4(finalColor, 1));


    //vec3 test = texelFetch(VelocityXYOcclusionSubSurface, px, 0).rgb;
    //imageStore(u_outputImage, px, vec4(test, 1));

}
