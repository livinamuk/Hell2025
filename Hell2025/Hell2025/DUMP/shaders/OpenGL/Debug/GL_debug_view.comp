layout (binding = 10) uniform usampler2D u_oceanFlagsTexture;
layout (binding = 11) uniform sampler2D u_depthTexture;
layout (binding = 12) uniform sampler2D u_emissiveTexture;
layout (binding = 13) uniform sampler2D u_occlusionHiZTexture;

readonly restrict layout(std430, binding = SSBO_IDX_RENDERER_DATA) buffer rendererDataBuffer { RendererData rendererData; };
readonly restrict layout(std430, binding = SSBO_IDX_VIEWPORT_DATA) buffer viewportDataBuffer { ViewportData viewportDataArr[]; };

vec3 IntegerToColor(uint x) {
    x = ((x >> 16) ^ x) * 0x45d9f3bE;
    x = ((x >> 16) ^ x) * 0x45d9f3bE;
    x = (x >> 16) ^ x;
    return vec3(float(x & 0xFFu) / 255.0, float((x >> 8) & 0xFFu) / 255.0, float((x >> 16) & 0xFFu) / 255.0);
}

